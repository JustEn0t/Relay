<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RELAY — анонсы стримов" Width="1180" Height="820" MinWidth="1030" MinHeight="740"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" Background="#101016"
        FontFamily="Segoe UI" FontSize="14" Foreground="#F2EFF8" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <SolidColorBrush x:Key="Accent" Color="#C2A0FF"/>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#F2EFF8"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style x:Key="Muted" TargetType="TextBlock"><Setter Property="Foreground" Value="#92909F"/><Setter Property="FontSize" Value="12"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style x:Key="Card" TargetType="Border"><Setter Property="CornerRadius" Value="16"/><Setter Property="Background" Value="#191920"/><Setter Property="BorderBrush" Value="#292830"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="20"/></Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#EDE9F5"/><Setter Property="Background" Value="#25242F"/><Setter Property="BorderBrush" Value="#383542"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="16,10"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="13"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9">
          <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.78"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.38"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#D6C5FF"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#B9A0FF"/><Setter Property="Foreground" Value="#17121F"/><Setter Property="BorderBrush" Value="#B9A0FF"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style x:Key="Navigation" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Margin" Value="0,0,0,7"/><Setter Property="Padding" Value="16,13"/><Setter Property="Height" Value="46"/></Style>
    <Style TargetType="ScrollBar"><Setter Property="Width" Value="8"/><Setter Property="Background" Value="Transparent"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="Transparent"><Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True"><Track.DecreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb Background="#655274"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{TemplateBinding Background}" CornerRadius="4" Margin="1"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#AF88D4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton></Track></Grid><ControlTemplate.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="8"/><Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#111117"/><Setter Property="Foreground" Value="#F2EFF8"/><Setter Property="CaretBrush" Value="#D5C5FF"/><Setter Property="SelectionBrush" Value="#695191"/><Setter Property="BorderBrush" Value="#37343F"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12,10"/><Setter Property="FontSize" Value="14"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="Field" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="#B9A0FF"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="PasswordBox">
      <Setter Property="Background" Value="#111117"/><Setter Property="Foreground" Value="#F2EFF8"/><Setter Property="CaretBrush" Value="#D5C5FF"/><Setter Property="SelectionBrush" Value="#695191"/><Setter Property="BorderBrush" Value="#37343F"/><Setter Property="Padding" Value="12,10"/><Setter Property="FontSize" Value="14"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="PasswordBox"><Border x:Name="Field" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="#B9A0FF"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Border BorderBrush="#34303F" BorderThickness="1" Background="#101016">
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border Grid.RowSpan="2" Background="#14141C" BorderBrush="#29262F" BorderThickness="0,0,1,0">
        <Grid Margin="18,28,18,20"><Grid.RowDefinitions><RowDefinition Height="92"/><RowDefinition Height="*"/><RowDefinition Height="142"/></Grid.RowDefinitions>
          <StackPanel><StackPanel Orientation="Horizontal" Margin="8,0,0,8"><Border Width="34" Height="34" CornerRadius="10" Background="#B9A0FF"><Path Data="M 12,8 L 24,17 L 12,26 Z" Fill="#21172E"/></Border><TextBlock Text="RELAY" FontSize="26" FontWeight="Bold" Margin="11,-2,0,0"/></StackPanel><TextBlock Text="ЭФИР НАЧИНАЕТСЯ ЗДЕСЬ" FontSize="9" Foreground="#77717F" Margin="9,5,0,0"/></StackPanel>
          <StackPanel Grid.Row="1">
            <Button x:Name="NavOverview" Style="{StaticResource Navigation}" AutomationProperties.Name="Обзор"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE80F;" Margin="0,1,13,0"/><TextBlock Text="Обзор"/></StackPanel></Button>
            <Button x:Name="NavConnections" Style="{StaticResource Navigation}" AutomationProperties.Name="Подключения"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE71B;" Margin="0,1,13,0"/><TextBlock Text="Подключения"/></StackPanel></Button>
            <Button x:Name="NavDesign" Style="{StaticResource Navigation}" AutomationProperties.Name="Карточки"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE91B;" Margin="0,1,13,0"/><TextBlock Text="Карточки"/></StackPanel></Button>
            <Button x:Name="NavGuide" Style="{StaticResource Navigation}" AutomationProperties.Name="Как подключить"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE897;" Margin="0,1,13,0"/><TextBlock Text="Как подключить"/></StackPanel></Button>
          </StackPanel>
          <StackPanel Grid.Row="2" VerticalAlignment="Bottom">
            <Border CornerRadius="12" Background="#1C1B25" Padding="13" Margin="0,0,0,16"><StackPanel><StackPanel Orientation="Horizontal"><Ellipse Width="6" Height="6" Fill="#A4D9BA" Margin="0,0,7,0"/><TextBlock Text="Работает на твоём ПК" FontSize="11"/></StackPanel><TextBlock Text="Ключи защищены Windows" Style="{StaticResource Muted}" FontSize="10" Margin="13,6,0,0"/></StackPanel></Border>
            <Button x:Name="SidebarAccount" Background="Transparent" BorderThickness="0" Padding="5,3" HorizontalContentAlignment="Left" AutomationProperties.Name="Подключённый канал Twitch"><StackPanel Orientation="Horizontal"><Border Width="34" Height="34" CornerRadius="17" Background="#30273D"><Grid><TextBlock x:Name="SidebarInitial" Text="+" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#C8B1FF"/><Image x:Name="SidebarAvatar" Visibility="Collapsed" Stretch="UniformToFill"><Image.Clip><EllipseGeometry Center="17,17" RadiusX="17" RadiusY="17"/></Image.Clip></Image></Grid></Border><StackPanel Margin="10,0,0,0" MaxWidth="135"><TextBlock x:Name="SidebarChannel" Text="Подключить Twitch" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><TextBlock x:Name="SidebarIdentityHint" Text="Канал не выбран" Style="{StaticResource Muted}" FontSize="10" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/></StackPanel></StackPanel></Button>
          </StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Column="1" x:Name="TitleBar" Background="#101016">
        <TextBlock x:Name="Breadcrumb" Text="Рабочее пространство  /  Обзор" Foreground="#827D8C" FontSize="11" VerticalAlignment="Center" Margin="30,0,0,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0">
          <Button x:Name="WindowMin" Content="—" Background="Transparent" BorderThickness="0" Padding="12,5" AutomationProperties.Name="Свернуть"/>
          <Button x:Name="WindowMax" Content="□" Background="Transparent" BorderThickness="0" Padding="12,5" AutomationProperties.Name="Развернуть"/>
          <Button x:Name="WindowClose" Content="×" Background="Transparent" BorderThickness="0" Padding="12,5" AutomationProperties.Name="Закрыть"/>
        </StackPanel>
      </Grid>
      <Grid Grid.Column="1" Grid.Row="1" Margin="30,16,30,18">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid x:Name="OverviewPage">
          <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="220"/><RowDefinition Height="116"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Grid><StackPanel><TextBlock Text="Обзор" FontSize="29" FontWeight="SemiBold"/><TextBlock Text="Твой стрим — уже в Telegram." Foreground="#96909F" FontSize="13" Margin="0,5,0,0"/></StackPanel><Button x:Name="StartButton" Content="Включить анонсы" Style="{StaticResource Primary}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,0,0" MinWidth="174"/></Grid>
          <Border Grid.Row="1" CornerRadius="18" BorderBrush="#674582" BorderThickness="1">
            <Border.Background><LinearGradientBrush StartPoint="0,1" EndPoint="1,0"><GradientStop Color="#20152E" Offset="0"/><GradientStop Color="#38204B" Offset="0.58"/><GradientStop Color="#25192E" Offset="1"/></LinearGradientBrush></Border.Background>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
              <Image x:Name="HeroImage" Grid.Column="1" Stretch="Uniform" Margin="4,30,20,10"/>
              <StackPanel Margin="27,24,0,16"><TextBlock Text="RELAY / STREAM ALERTS" Foreground="#C5A7EC" FontSize="9" FontWeight="SemiBold"/><TextBlock Text="Стрим начался." FontSize="30" FontWeight="SemiBold" Margin="0,10,0,0"/><TextBlock Text="Анонс уже летит." FontSize="30" FontWeight="SemiBold" Foreground="#E0BAFF" Margin="0,-1,0,0"/><TextBlock Text="Из Twitch — прямо в твой Telegram.&#10;Автоматически, с твоим оформлением." Foreground="#BDABC9" FontSize="11" Margin="0,9,0,0" LineHeight="17"/><Button x:Name="HeroGuide" Content="Как подключить   →" FontSize="11" Foreground="#F2C0EC" Background="Transparent" BorderThickness="0" Padding="0,6" Margin="0,5,0,0" HorizontalAlignment="Left"/></StackPanel>
              <Border x:Name="MonitorPill" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top" CornerRadius="12" Background="#33283D" Padding="11,6" Margin="0,14,14,0"><TextBlock x:Name="MonitorPillText" Text="НА ПАУЗЕ" FontSize="9" FontWeight="SemiBold" Foreground="#CCB6E4"/></Border>
            </Grid>
          </Border>
          <UniformGrid Grid.Row="2" Columns="3" Margin="0,15,0,15">
            <Border Style="{StaticResource Card}" Margin="0,0,9,0" Padding="16,13"><StackPanel><TextBlock Text="МОНИТОРИНГ" Style="{StaticResource Muted}" FontSize="9"/><TextBlock x:Name="MonitorValue" Text="На паузе" FontSize="19" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock Text="Проверка раз в 10 секунд" Style="{StaticResource Muted}" FontSize="10" Margin="0,4,0,0"/></StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="0,0,9,0" Padding="16,13"><StackPanel><TextBlock Text="TWITCH → TELEGRAM" Style="{StaticResource Muted}" FontSize="9"/><TextBlock x:Name="ConnectionValue" Text="Нужна проверка" FontSize="19" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock x:Name="ConnectionHint" Text="Настрой подключение" Style="{StaticResource Muted}" FontSize="10" Margin="0,4,0,0"/></StackPanel></Border>
            <Border Style="{StaticResource Card}" Padding="16,13"><StackPanel><TextBlock Text="ПОСЛЕДНЯЯ ПРОВЕРКА" Style="{StaticResource Muted}" FontSize="9"/><TextBlock x:Name="CheckedValue" Text="—" FontSize="19" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock x:Name="NextCheckHint" Text="Включи анонсы для старта" Style="{StaticResource Muted}" FontSize="10" Margin="0,4,0,0"/></StackPanel></Border>
          </UniformGrid>
          <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="1.6*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Margin="0,0,15,0" Padding="16"><Grid><Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="*"/><RowDefinition Height="31"/></Grid.RowDefinitions><TextBlock Text="Твой анонс" FontSize="14" FontWeight="SemiBold"/><Image x:Name="DashboardPreview" Grid.Row="1" Stretch="Uniform"/><Button x:Name="OpenDesign" Grid.Row="2" Content="Открыть карточки   →" Padding="0,6" Background="Transparent" BorderThickness="0" HorizontalAlignment="Left" FontSize="11" Foreground="#C7B0FF"/></Grid></Border>
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="17"><Grid><Grid.RowDefinitions><RowDefinition Height="33"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Активность" FontSize="14" FontWeight="SemiBold"/><ListBox x:Name="ActivityList" Grid.Row="1" Background="Transparent" BorderThickness="0" Foreground="#B7AFBF" FontSize="11" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0,0,0,13"/><Setter Property="Focusable" Value="False"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Time}" Foreground="#706A7B" FontSize="9" Margin="0,0,0,3"/><TextBlock Text="{Binding Text}" Foreground="#C6BFCE" FontSize="11" TextWrapping="Wrap"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Border>
          </Grid>
        </Grid>
        <ScrollViewer x:Name="ConnectionsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
          <StackPanel><TextBlock Text="Подключения" FontSize="29" FontWeight="SemiBold"/><TextBlock Text="Одна настройка — и анонсы работают сами." Foreground="#96909F" FontSize="13" Margin="0,5,0,24"/>
            <Border x:Name="RunningNotice" Visibility="Collapsed" Style="{StaticResource Card}" Margin="0,0,0,16" Padding="15"><DockPanel><Button x:Name="StopForSettings" Content="Остановить бота" DockPanel.Dock="Right" Padding="12,7" Margin="12,0,0,0"/><TextBlock Text="Мониторинг включён. Для изменения подключений останови бота." Foreground="#C7B8D7" FontSize="12" VerticalAlignment="Center"/></DockPanel></Border>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border Style="{StaticResource Card}" Margin="0,0,14,0"><StackPanel><TextBlock Text="Twitch" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="Откуда забирать эфир" Style="{StaticResource Muted}" Margin="0,4,0,22"/><TextBlock Text="Канал" Style="{StaticResource Muted}" Margin="0,0,0,7"/><TextBox x:Name="ChannelField" AutomationProperties.Name="Канал Twitch"/><TextBlock Text="Client ID" Style="{StaticResource Muted}" Margin="0,18,0,7"/><TextBox x:Name="ClientIdField" AutomationProperties.Name="Twitch Client ID"/><TextBlock Text="Client Secret" Style="{StaticResource Muted}" Margin="0,18,0,7"/><PasswordBox x:Name="ClientSecretField" AutomationProperties.Name="Twitch Client Secret"/><TextBlock Text="Ключи твоего приложения Twitch Developers." Style="{StaticResource Muted}" FontSize="10" Margin="0,16,0,0"/></StackPanel></Border>
              <Border Grid.Column="1" Style="{StaticResource Card}"><StackPanel><TextBlock Text="Telegram" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="Куда отправлять анонсы" Style="{StaticResource Muted}" Margin="0,4,0,22"/><TextBlock Text="Канал" Style="{StaticResource Muted}" Margin="0,0,0,7"/><TextBox x:Name="DestinationField" AutomationProperties.Name="Telegram-канал"/><TextBlock Text="Токен бота" Style="{StaticResource Muted}" Margin="0,18,0,7"/><PasswordBox x:Name="TelegramField" AutomationProperties.Name="Токен BotFather"/><Button x:Name="FindButton" Content="Найти приватный канал" Margin="0,18,0,0" HorizontalAlignment="Left"/><TextBlock Text="Бот должен быть администратором канала с правом публикации." Style="{StaticResource Muted}" FontSize="10" Margin="0,17,0,0"/></StackPanel></Border>
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="0,22,0,0"><Button x:Name="CheckButton" Content="Сохранить и проверить" Style="{StaticResource Primary}"/><Button x:Name="TestButton" Content="Отправить тест" Margin="12,0,0,0"/></StackPanel>
            <TextBlock Text="Ключи сохраняются на этом компьютере и защищены твоей учётной записью Windows." Foreground="#77717F" FontSize="11" Margin="0,18,0,0"/>
          </StackPanel>
        </ScrollViewer>
        <Grid x:Name="DesignPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="45"/><RowDefinition Height="*"/><RowDefinition Height="70"/></Grid.RowDefinitions>
          <StackPanel><TextBlock Text="Карточки эфира" FontSize="29" FontWeight="SemiBold"/><TextBlock Text="Так твой стрим увидят в Telegram." Foreground="#96909F" FontSize="13" Margin="0,5,0,0"/></StackPanel>
          <Grid Grid.Row="1"><StackPanel Orientation="Horizontal"><Button x:Name="LiveTab" Content="Начало эфира" Padding="15,7" Background="#3A2C50" BorderBrush="#6E518B"/><Button x:Name="OngoingTab" Content="В эфире" Padding="15,7" Margin="10,0,0,0"/><Button x:Name="EndedTab" Content="Завершение" Padding="15,7" Margin="10,0,0,0"/></StackPanel><Button x:Name="RefreshPreview" Content="Обновить превью" Padding="15,7" HorizontalAlignment="Right"/></Grid>
          <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,15,0,0" Padding="14"><Image x:Name="DesignPreview" Stretch="Uniform"/></Border>
          <StackPanel Grid.Row="3" Margin="2,16,0,0"><TextBlock x:Name="DesignHint" Text="Название, игра и превью подставляются с Twitch автоматически." Foreground="#C1B5CE" FontSize="12"/><TextBlock Text="Проверка эфира — 10 сек. Обновление кадра — 2 мин. Здесь ничего не публикуется." Style="{StaticResource Muted}" FontSize="10" Margin="0,6,0,0"/></StackPanel>
        </Grid>
        <ScrollViewer x:Name="GuidePage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="Первый эфир с RELAY" Foreground="#EADCF7" FontSize="29" FontWeight="SemiBold"/>
            <TextBlock Text="Четыре шага — и зрители узнают о стриме." Foreground="#AFA0BD" FontSize="13" Margin="0,6,0,22"/>
            <Border CornerRadius="14" Background="#2C203B" BorderBrush="#513B6A" BorderThickness="1" Padding="18" Margin="0,0,0,16"><StackPanel><TextBlock Text="Твои каналы. Твои ключи. Твой контроль." FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Каждый пользователь подключает собственного Telegram-бота и приложение Twitch. RELAY работает на твоём ПК — держи окно открытым во время стрима." Foreground="#BDAEC9" FontSize="11" Margin="0,8,0,0"/></StackPanel></Border>
            <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="43"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="01" FontSize="24" Foreground="#BD9EEC" FontWeight="SemiBold"/><StackPanel Grid.Column="1"><TextBlock Text="Создай Telegram-бота" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Открой официального @BotFather → /newbot. Задай имя и уникальный username, который заканчивается на bot. Полученный токен вставь в «Подключения → Telegram»." Foreground="#A9A0B5" FontSize="12" Margin="0,7,0,12"/><Button x:Name="GuideBotFather" Content="Открыть BotFather ↗" HorizontalAlignment="Left" Padding="13,7"/></StackPanel></Grid></Border>
            <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="43"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="02" FontSize="24" Foreground="#BD9EEC" FontWeight="SemiBold"/><StackPanel Grid.Column="1"><TextBlock Text="Добавь бота в свой Telegram-канал" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Канал → Управление каналом / Изменить → Администраторы → Добавить администратора. Выбери бота и разреши публикацию сообщений. Публичный канал можно указать как @username. Для приватного нажми «Найти приватный канал» в подключениях. Если его нет в списке, опубликуй в канале любой пост и повтори поиск." Foreground="#A9A0B5" FontSize="12" Margin="0,7,0,0"/></StackPanel></Grid></Border>
            <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="43"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="03" FontSize="24" Foreground="#BD9EEC" FontWeight="SemiBold"/><StackPanel Grid.Column="1"><TextBlock Text="Получи ключи Twitch" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="В консоли Twitch Developers выбери Applications → Register Your Application. Нужно подтвердить почту и включить двухфакторную аутентификацию. Название приложения должно быть уникальным. Категория — Chat Bot, тип клиента — Confidential. В Redirect URL укажи https://localhost и нажми «Добавить»." Foreground="#A9A0B5" FontSize="12" Margin="0,7,0,10"/><TextBlock Text="После создания: Manage → Client ID → New Secret. Введи Client ID и Client Secret в RELAY. Общие ключи разработчика в сборку не включены." Foreground="#A9A0B5" FontSize="12" Margin="0,0,0,12"/><WrapPanel><Button x:Name="GuideTwitch" Content="Открыть консоль Twitch ↗" Padding="13,7" Margin="0,0,10,8"/><Button x:Name="CopyRedirect" Content="Копировать Redirect URL" Padding="13,7" Margin="0,0,10,8"/><Button x:Name="GuideDocs" Content="Документация ↗" Padding="13,7" Margin="0,0,0,8"/></WrapPanel></StackPanel></Grid></Border>
            <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="43"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="04" FontSize="24" Foreground="#BD9EEC" FontWeight="SemiBold"/><StackPanel Grid.Column="1"><TextBlock Text="Проверь подключение и включи анонсы" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Введи ник Twitch без @ и ссылок. Нажми «Сохранить и проверить»: в меню появятся имя и аватар выбранного канала. Затем открой «Обзор → Включить анонсы». Если канал уже в эфире, бот опубликует анонс сразу. Проверка — каждые 10 секунд, итог — после трёх проверок офлайна." Foreground="#A9A0B5" FontSize="12" Margin="0,7,0,12"/><TextBlock x:Name="GuideProgress" Text="Сначала подключи своего бота и канал Twitch." Foreground="#CCA8F0" FontSize="11" Margin="0,0,0,12"/><Button x:Name="GuideConnections" Content="Перейти к подключениям →" Style="{StaticResource Primary}" HorizontalAlignment="Left"/></StackPanel></Grid></Border>
            <TextBlock Text="Пароль Twitch и ключ трансляции OBS не нужны. Секретные токены вводи только в приложении. Статистика считается по замерам RELAY, а данные Twitch могут приходить с задержкой." Foreground="#82798E" FontSize="11" Margin="2,8,2,14"/>
          </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Margin="0,15,0,0">
          <Border x:Name="RecoveryPanel" Visibility="Collapsed" CornerRadius="10" Background="#352231" Padding="12" Margin="0,0,0,10"><DockPanel><Button x:Name="RecoverButton" Content="Разрешить повтор" DockPanel.Dock="Right" Padding="10,6" Margin="10,0,0,0"/><TextBlock Text="Отправка анонса не подтверждена. Сначала проверь Telegram-канал." Foreground="#E4B7D0" FontSize="11" VerticalAlignment="Center"/></DockPanel></Border>
          <DockPanel><Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="#A995C2" Margin="0,0,8,0"/><TextBlock x:Name="StatusText" Text="Готов к работе" FontSize="11" Foreground="#9D93AB" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/></DockPanel>
          <DockPanel Margin="14,6,0,0"><Button x:Name="RetryDeletionButton" Content="Повторить удаление" Visibility="Collapsed" DockPanel.Dock="Right" FontSize="10" Padding="9,4" Margin="10,0,0,0"/><TextBlock x:Name="DeletionHint" Text="Автоудаление анонса — через 1 ч после эфира" Foreground="#82758F" FontSize="10" VerticalAlignment="Center"/></DockPanel>
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</Window>
